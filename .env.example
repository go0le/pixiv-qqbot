# ===== NapCat（OneBot 11）机器人「哈Gemi」=====
# 管理员 QQ 号，逗号分隔：可以安排服务器上的工作、改白/黑名单（也可以写在 ~/.dsh-qqbot/access.json 的 admins 里）
NAPCAT_ADMIN_IDS=
# 机器人自己的 QQ 号；不填则连上 NapCat 后自动获取
NAPCAT_SELF_ID=
NAPCAT_WS_URL=ws://127.0.0.1:3001

# Pixiv（refresh token 用 scripts/pixiv-oauth.mjs 获取）
PIXIV_REFRESH_TOKEN=
# 所有搜图途径共用的「已发 PID」记录
PIXIV_HISTORY_FILE=
# 按会话的找图偏好（图片反馈）；不填默认 ~/.dsh-qqbot/pixiv-shared/pixiv_prefs.json，pixiv-mcp 要配成同一个文件
PIXIV_PREFS_FILE=
# 每日一图总开关（0 = 关）
NAPCAT_DAILY_PUSH=1

# ===== 官方 QQ Bot 通道（旧）=====
QQBOT_APPID=
QQBOT_SECRET=

# DeepSeek API
DEEPSEEK_API_KEY=

# Agent 工作目录（可选）
DSH_CWD=/tmp/dsh-qqbot
